[alias]
	st = status
	sw = switch
	sc = switch -c
	cia = commit -am

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[ghq]
	root = ~/src

[push]
	autoSetupRemote = true
[fetch]
	prune = true
[pull]
	rebase = true
[rebase]
	autoStash = true
[rerere]
	enabled = true

[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
# Kanagawa Dragon has no built-in delta theme, so syntax follows the terminal's ANSI palette.
[delta]
	navigate = true
	syntax-theme = ansi
	minus-style = syntax "#43242b"
	minus-emph-style = bold "#c4746e" "#43242b"
	plus-style = syntax "#2b3328"
	plus-emph-style = bold "#87a987" "#2b3328"
	file-style = bold "#8ba4b0"
	file-decoration-style = "#8ba4b0" ul
	hunk-header-decoration-style = "#393836" box

[diff]
	algorithm = histogram
[merge]
	conflictStyle = zdiff3
[branch]
	sort = -committerdate

[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
